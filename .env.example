# ===== LAMPOSE Voice AI — environment =====
# SECURITY: keep this file private (chmod 600). Rotate keys after setup.

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your-token
TWILIO_NUMBER=+19476228419

# --- Sarvam AI (STT + TTS) ---
SARVAM_API_KEY=sk_xxxx

# --- Anthropic (LLM brain) --- get key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Public server URL (DNS A-record -> VPS IP, TLS via certbot) ---
SERVER_URL=https://voice.lampose.in

# --- Voice (Sarvam bulbul:v3). Try on the dashboard: kavya, shreya, pooja (F) / shubh, gokul, aditya (M)
TTS_VOICE=kavya
TTS_MODEL=bulbul:v3
TTS_PACE=1.0

# --- STT ---
STT_LANGUAGE=te-IN
# optional: codemix | transcribe (leave empty for model default)
STT_MODE=

# --- Sales / business ---
SALES_TRANSFER_NUMBER=+919398334115
AGENT_NAME=Kavya
COMPANY_NAME=LAMPOSE

# --- Dialer ---
DIALER_ENABLED=false
MAX_CONCURRENT_CALLS=3
CALLING_HOURS_START=10
CALLING_HOURS_END=19
MAX_ATTEMPTS=3
RETRY_DELAY_HOURS=4

# --- MongoDB ---
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=lampose_voice

# --- Dashboard login (HTTP Basic) ---
DASHBOARD_USER=lampose
DASHBOARD_PASSWORD=change-me

# --- Misc ---
PORT=7860
TIMEZONE=Asia/Kolkata
